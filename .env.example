# Copy this file to `.env` (repo root) and fill in real values.
# `.env` is gitignored — NEVER commit real keys.

# TomTom Traffic API key — ONLY needed for the optional crawl step
# `scripts/03a_crawl_tomtom.py` (run 4 times at 07:30/12:00/17:30/22:00).
# Get one free at https://developer.tomtom.com (Traffic Flow API).
# Everything else — build, demo, tests, benchmark — runs WITHOUT this
# (03b falls back to seeded synthetic congestion).
TOMTOM_API_KEY=

# ---------------------------------------------------------------------
# Frontend (NOT read from this file): if the backend runs somewhere other
# than http://localhost:8000, create `frontend/.env.local` containing:
#   NEXT_PUBLIC_API_BASE=http://<host>:<port>
